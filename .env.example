# Desenvolvimento local: copie para .env e rode `npm run dev` (o `npm start` não lê este arquivo).
# Em produção, configure estas variáveis na área Variables do Railway.
NODE_ENV=development
PORT=3000
ADMIN_PIN=troque-por-um-pin-forte-de-pelo-menos-8-digitos
DATA_DIR=./data
FACE_THRESHOLD=0.5
# Só em desenvolvimento: "false" libera bater ponto sem parear o aparelho. Em produção é sempre exigido.
REQUIRE_DEVICE=true
